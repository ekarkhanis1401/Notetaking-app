{
  "name": "linkedin-job-bot",
  "version": "1.0.0",
  "description": "AI-powered LinkedIn job application bot with Claude AI resume tailoring, cover letter generation, and recruiter outreach",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:apply": "node src/index.js --mode apply",
    "start:connect": "node src/index.js --mode connect",
    "start:dry-run": "node src/index.js --dry-run",
    "install-browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.44.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "pdfmake": "^0.2.10",
    "fs-extra": "^11.2.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^10.1.2",
    "dayjs": "^1.11.11",
    "p-limit": "^6.1.0",
    "exceljs": "^4.4.0"
  }
}
