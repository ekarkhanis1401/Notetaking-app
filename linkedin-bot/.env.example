# ============================================================
# LinkedIn Job Bot — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control
# ============================================================

# --- LinkedIn Credentials ---
LINKEDIN_EMAIL=your.email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# --- Anthropic / Claude AI ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- Bot Behaviour ---
# Maximum number of jobs to process per session
MAX_JOBS_PER_SESSION=10

# Seconds to wait between each job application (helps avoid rate-limiting)
DELAY_BETWEEN_JOBS_MIN=30
DELAY_BETWEEN_JOBS_MAX=90

# Whether to actually submit applications (true) or just dry-run (false)
AUTO_APPLY=true

# Whether to send connection requests to recruiters
AUTO_CONNECT=true

# Whether to send recruiter messages after connecting
SEND_RECRUITER_MESSAGE=true

# How many days to wait after connecting before sending a follow-up message
# (0 = send with the connection request note)
FOLLOW_UP_DELAY_DAYS=0

# --- Browser ---
# Set to "true" to run with a visible browser window (useful for debugging)
HEADLESS=true

# Chromium user data directory – keeps you logged in between sessions
USER_DATA_DIR=./browser-data

# --- Output ---
# Directory to save generated resumes and cover letters
OUTPUT_DIR=./output

# --- Excel Tracker ---
# Full path to the Job Applications Excel tracker.
# Override this if you move the file or are on a different machine.
TRACKER_PATH=/Users/paragkarkhanis/Desktop/Personal/Parag Resume/Job Applications/Job_Applications_Tracker.xlsx
